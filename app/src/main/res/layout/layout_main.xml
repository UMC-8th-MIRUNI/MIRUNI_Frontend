<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/main_nav_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.93"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/main_nav_home_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="15sp"
        android:paddingTop="52sp"
        android:paddingBottom="14sp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/main_top_bar_alarm_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/main_bell"
            android:layout_marginStart="15sp"
            app:layout_constraintTop_toTopOf="@id/main_top_bar_title_tv"
            app:layout_constraintBottom_toBottomOf="@id/main_top_bar_title_tv"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/main_top_bar_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIRUNI"
            android:fontFamily="@font/climatecrisis_regular"
            android:textSize="22sp"
            android:letterSpacing="0.03"
            android:textColor="#2E442D"
            android:shadowDy="3.66"
            android:shadowColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_top_bar_peanut_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="6sp"
            android:paddingVertical="2sp"
            android:background="@drawable/bg_d9d9d9_square_40"
            android:layout_marginEnd="15sp"
            app:layout_constraintTop_toTopOf="@id/main_top_bar_title_tv"
            app:layout_constraintBottom_toBottomOf="@id/main_top_bar_title_tv"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/main_top_bar_peanut_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                android:src="@drawable/peanut"
                app:layout_constraintEnd_toStartOf="@id/main_top_bar_peanut_tv"
                app:layout_constraintStart_toStartOf="@id/main_top_bar_peanut_count"
                app:layout_constraintTop_toTopOf="@id/main_top_bar_peanut_tv"
                app:layout_constraintBottom_toBottomOf="@id/main_top_bar_peanut_tv"/>
            <TextView
                android:id="@+id/main_top_bar_peanut_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="37"
                android:textSize="11.5sp"
                android:textColor="#29AD25"
                app:layout_constraintTop_toTopOf="@id/main_top_bar_peanut_count"
                app:layout_constraintBottom_toBottomOf="@id/main_top_bar_peanut_count"
                app:layout_constraintEnd_toEndOf="@id/main_top_bar_peanut_count"
                app:layout_constraintStart_toEndOf="@id/main_top_bar_peanut_iv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/main_frm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/main_top_bar"
        app:layout_constraintBottom_toTopOf="@id/main_nav"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingTop="5dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_tool_start_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.101"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_tool_end_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.165"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_calendar_start_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.294"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_calendar_end_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.35"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_locker_start_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.655"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_locker_end_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.717"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_my_start_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.839"/>
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/main_my_end_line"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.905"/>

            <ImageView
                android:id="@+id/main_nav_tool_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_tool"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="@id/main_tool_start_line"
                app:layout_constraintEnd_toStartOf="@id/main_tool_end_line"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/main_nav_tool_tv"/>
            <TextView
                android:id="@+id/main_nav_tool_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도구"
                android:textSize="10.5sp"
                android:layout_marginBottom="6sp"
                app:layout_constraintTop_toBottomOf="@id/main_nav_tool_iv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/main_nav_tool_iv"
                app:layout_constraintEnd_toEndOf="@id/main_nav_tool_iv"/>

            <ImageView
                android:id="@+id/main_nav_calendar_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_calendar"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="@id/main_calendar_start_line"
                app:layout_constraintEnd_toStartOf="@id/main_calendar_end_line"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/main_nav_calendar_tv"/>
            <TextView
                android:id="@+id/main_nav_calendar_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="캘린더"
                android:textSize="10.5sp"
                android:layout_marginBottom="6sp"
                app:layout_constraintTop_toBottomOf="@id/main_nav_calendar_iv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/main_nav_calendar_iv"
                app:layout_constraintEnd_toEndOf="@id/main_nav_calendar_iv"/>

            <ImageView
                android:id="@+id/main_nav_locker_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_locker"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="@id/main_locker_start_line"
                app:layout_constraintEnd_toEndOf="@id/main_locker_end_line"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/main_nav_locker_tv"/>
            <TextView
                android:id="@+id/main_nav_locker_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보관함"
                android:textSize="10.5sp"
                android:layout_marginBottom="6sp"
                app:layout_constraintTop_toBottomOf="@id/main_nav_locker_iv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/main_nav_locker_iv"
                app:layout_constraintEnd_toEndOf="@id/main_nav_locker_iv"/>

            <ImageView
                android:id="@+id/main_nav_mypage_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_mypage"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="@id/main_my_start_line"
                app:layout_constraintEnd_toEndOf="@id/main_my_end_line"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/main_nav_mypage_tv"/>
            <TextView
                android:id="@+id/main_nav_mypage_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="마이페이지"
                android:textSize="10.5sp"
                android:layout_marginBottom="6sp"
                app:layout_constraintTop_toBottomOf="@id/main_nav_mypage_iv"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/main_nav_mypage_iv"
                app:layout_constraintEnd_toEndOf="@id/main_nav_mypage_iv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/main_nav_home_start_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.428"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/main_nav_home_end_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.572"/>

        <ImageView
            android:id="@+id/main_nav_home_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/ic_home"
            android:padding="12sp"
            android:background="@drawable/bg_1ae019_circle"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/main_nav_home_start_line"
            app:layout_constraintEnd_toEndOf="@id/main_nav_home_end_line"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>