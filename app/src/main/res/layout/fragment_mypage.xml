<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setting"
    tools:context=".MypageFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_profile_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.145"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_profile_start_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.355"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_profile_end_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.645"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_name_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.282"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_email_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.32"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_edit_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.37"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_edit_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.43"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_edit_start_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.289"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/mypage_setting_edit_end_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.711"/>


    <ImageView
        android:id="@+id/mypage_setting_profile_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@mipmap/ic_main_round"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/mypage_setting_profile_top_line"
        app:layout_constraintStart_toStartOf="@id/mypage_setting_profile_start_line"
        app:layout_constraintEnd_toEndOf="@id/mypage_setting_profile_end_line"/>

    <TextView
        android:id="@+id/mypage_setting_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lee"
        android:fontFamily="@font/notosanskr_bold"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/mypage_setting_name_top_line"
        app:layout_constraintStart_toStartOf="@id/mypage_setting_profile_iv"
        app:layout_constraintEnd_toEndOf="@id/mypage_setting_profile_iv"/>
    <TextView
        android:id="@+id/mypage_setting_email_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lee@gmail.com"
        android:fontFamily="@font/dmsans_light"
        app:layout_constraintTop_toTopOf="@id/mypage_setting_email_top_line"
        app:layout_constraintStart_toStartOf="@id/mypage_setting_profile_iv"
        app:layout_constraintEnd_toEndOf="@id/mypage_setting_profile_iv"/>

    <TextView
        android:id="@+id/mypage_setting_edit_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="프로필 편집"
        android:fontFamily="@font/dmsans_bold"
        android:textColor="@color/main"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/bg_white_square_8"
        app:layout_constraintTop_toTopOf="@id/mypage_setting_edit_top_line"
        app:layout_constraintBottom_toBottomOf="@id/mypage_setting_edit_bottom_line"
        app:layout_constraintStart_toStartOf="@id/mypage_setting_edit_start_line"
        app:layout_constraintEnd_toEndOf="@id/mypage_setting_edit_end_line"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mypage_setting_frm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_white_square_25"
        app:layout_constraintTop_toTopOf="@id/mypage_setting_top_line"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/mypage_setting_account_top_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.144"/>

        <TextView
            android:id="@+id/mypage_setting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:fontFamily="@font/dmsans_bold"
            android:textSize="17sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mypage_setting_account_frm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_black_squre_14"
            android:layout_marginHorizontal="10sp"
            android:paddingHorizontal="10dp"
            app:layout_constraintTop_toTopOf="@id/mypage_setting_account_top_line">

            <ImageView
                android:id="@+id/mypage_setting_account_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/mypage_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/mypage_setting_account_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="계정 설정"
                android:fontFamily="@font/dmsans_regular"
                android:textSize="15sp"
                android:layout_marginVertical="20dp"
                app:layout_constraintStart_toEndOf="@id/mypage_setting_account_iv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/mypage_setting_account_more_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mypage_setting_alarm_frm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_black_squre_14"
            android:layout_marginHorizontal="10sp"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@id/mypage_setting_account_frm">

            <ImageView
                android:id="@+id/mypage_setting_alarm_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/mypage_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/mypage_setting_alarm_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="알림 설정"
                android:fontFamily="@font/dmsans_regular"
                android:textSize="15sp"
                android:layout_marginVertical="20dp"
                app:layout_constraintStart_toEndOf="@id/mypage_setting_alarm_iv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/mypage_setting_alarm_more_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mypage_setting_info_frm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_black_squre_14"
            android:layout_marginHorizontal="10sp"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@id/mypage_setting_alarm_frm">

            <ImageView
                android:id="@+id/mypage_setting_info_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/mypage_user"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/mypage_setting_info_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="문의 및 정보"
                android:fontFamily="@font/dmsans_regular"
                android:textSize="15sp"
                android:layout_marginVertical="20dp"
                app:layout_constraintStart_toEndOf="@id/mypage_setting_info_iv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/mypage_setting_info_more_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>