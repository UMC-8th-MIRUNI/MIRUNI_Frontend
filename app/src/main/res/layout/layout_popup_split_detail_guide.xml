            android:id="@+id/popup_split_detail_guide_item3_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/split_detail_guide_item3"
            android:fontFamily="@font/dmsans_regular"
            android:textSize="11sp"
            android:lineSpacingExtra="0dp"
            app:layout_constraintTop_toBottomOf="@id/popup_split_detail_guide_item3_title_tv"
            app:layout_constraintStart_toStartOf="@id/popup_split_detail_guide_item_content_start_line"
