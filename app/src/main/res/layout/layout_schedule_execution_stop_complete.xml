<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_title_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_content_start_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.158"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_content_end_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.830"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_content_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.241"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_content_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.556"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_txt1_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.636"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_txt2_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.706"/>


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_btn_start_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.042"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_btn_end_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.958"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/schedule_execution_sc_btn_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.971"/>

    <!-- 내용 -->

    <TextView
        android:id="@+id/schedule_execution_sc_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:fontFamily="@font/climatecrisis_regular"
        android:textSize="22sp"
        android:lineSpacingExtra="11sp"
        android:letterSpacing="0.03"
        android:textColor="#2E442D"
        android:shadowDy="3.66"
        android:shadowRadius="3.66"
        android:shadowColor="#40000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/schedule_execution_sc_title_top_line"/>
    <ImageView
        android:id="@+id/schedule_execution_sc_miruni_iv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/schedule_execution_miruni_face"
        app:layout_constraintStart_toEndOf="@id/schedule_execution_sc_content_start_line"
        app:layout_constraintEnd_toEndOf="@id/schedule_execution_sc_content_end_line"
        app:layout_constraintTop_toTopOf="@id/schedule_execution_sc_content_top_line"
        app:layout_constraintBottom_toBottomOf="@id/schedule_execution_sc_content_bottom_line"/>

    <TextView
        android:id="@+id/schedule_execution_sc_txt1_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정말 중지하시겠어요?"
        android:fontFamily="@font/dmsans_bold"
        android:textSize="24sp"
        android:textColor="#1B2128"
        app:layout_constraintTop_toTopOf="@id/schedule_execution_sc_txt1_top_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/schedule_execution_sc_txt2_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/schedule_execution_guide"
        android:fontFamily="@font/notosanskr_medium"
        android:textSize="16sp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="@id/schedule_execution_sc_txt2_top_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/schedule_execution_sc_cancel_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="취소"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="16sp"
        android:textColor="#EBFFE9"
        android:background="@drawable/bg_07d500_sqaure_10"
        android:gravity="center_horizontal"
        android:paddingVertical="10sp"
        app:layout_constraintBottom_toBottomOf="@id/schedule_execution_sc_btn_bottom_line"
        app:layout_constraintStart_toStartOf="@id/schedule_execution_sc_btn_start_line"
        app:layout_constraintEnd_toStartOf="@id/schedule_execution_sc_check_tv"/>
    <TextView
        android:id="@+id/schedule_execution_sc_check_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="확인"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="16sp"
        android:textColor="#EBFFE9"
        android:background="@drawable/bg_07d500_sqaure_10"
        android:gravity="center_horizontal"
        android:layout_marginStart="8sp"
        android:paddingVertical="10sp"
        app:layout_constraintBottom_toBottomOf="@id/schedule_execution_sc_btn_bottom_line"
        app:layout_constraintStart_toEndOf="@id/schedule_execution_sc_cancel_tv"
        app:layout_constraintEnd_toEndOf="@id/schedule_execution_sc_btn_end_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>