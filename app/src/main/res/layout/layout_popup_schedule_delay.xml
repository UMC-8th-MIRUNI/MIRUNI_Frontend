<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="330sp"
    android:minHeight="335sp"
    android:background="@drawable/bg_white_square_20"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.078"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.946"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_start_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.061"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_end_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.939"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_select_frm_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.430"/>
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_select_frm_bottom_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.573"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/popup_schedule_delay_btn_top_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.815"/>

    <TextView
        android:id="@+id/popup_schedule_delay_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/popup_schedule_delay_title"
        android:gravity="center_horizontal"
        android:fontFamily="@font/dmsans_regular"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/popup_schedule_delay_top_line"
        app:layout_constraintStart_toStartOf="@id/popup_schedule_delay_start_line"
        app:layout_constraintEnd_toEndOf="@id/popup_schedule_delay_end_line"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/popup_schedule_delay_select_frm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_ababab_square_7"
        android:paddingHorizontal="11dp"
        app:layout_constraintStart_toStartOf="@id/popup_schedule_delay_start_line"
        app:layout_constraintEnd_toEndOf="@id/popup_schedule_delay_end_line"
        app:layout_constraintTop_toTopOf="@id/popup_schedule_delay_select_frm_top_line"
        app:layout_constraintBottom_toBottomOf="@id/popup_schedule_delay_select_frm_bottom_line">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/popup_schedule_delay_select_calendar_start_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.888"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/popup_schedule_delay_select_calendar_end_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.963"/>

        <TextView
            android:id="@+id/popup_schedule_delay_select_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025.08.15. 07:00"
            android:fontFamily="@font/poppins_regular"
            android:textSize="14sp"
            android:textColor="#484C52"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:id="@+id/popup_schedule_delay_select_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            android:src="@drawable/schedule_registration_calendar"
            app:layout_constraintStart_toStartOf="@id/popup_schedule_delay_select_calendar_start_line"
            app:layout_constraintEnd_toEndOf="@id/popup_schedule_delay_select_calendar_end_line"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/popup_schedule_delay_cancel_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="취소"
        android:gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_07d500_sqaure_10"
        app:layout_constraintTop_toTopOf="@id/popup_schedule_delay_btn_top_line"
        app:layout_constraintBottom_toBottomOf="@id/popup_schedule_delay_bottom_line"
        app:layout_constraintStart_toStartOf="@id/popup_schedule_delay_start_line"
        app:layout_constraintEnd_toStartOf="@id/popup_schedule_delay_ok_tv"/>
    <TextView
        android:id="@+id/popup_schedule_delay_ok_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="확인"
        android:gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/bg_07d500_sqaure_10"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toTopOf="@id/popup_schedule_delay_btn_top_line"
        app:layout_constraintBottom_toBottomOf="@id/popup_schedule_delay_bottom_line"
        app:layout_constraintStart_toEndOf="@id/popup_schedule_delay_cancel_tv"
        app:layout_constraintEnd_toEndOf="@id/popup_schedule_delay_end_line"/>
        
</androidx.constraintlayout.widget.ConstraintLayout>