<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색: 흰색 -->
    <solid android:color="#E8F5E9" />

    <!-- 둥근 모서리 -->
    <corners android:radius="50dp" />

    <!-- 테두리 -->
    <stroke
        android:width="2dp"
        android:color="#C7DFC6" />

    <!-- 안쪽 여백 -->
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="12dp"
        android:bottom="6dp" />
</shape>
