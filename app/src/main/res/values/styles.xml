<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- CalendarView 전체 -->
    <style name="CalendarViewCustom" parent="Theme.AppCompat">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textColor">#000000</item>
    </style>

    <!-- CalendarView의 헤더 -->
    <style name="CalendarViewHeaderCustom">
        <item name="android:textSize">28sp</item>
    </style>

    <!-- CalendarView의 요일 -->
    <style name="CalendarViewWeekCustom" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#989898</item>
    </style>

    <!-- 날짜 선택 시 색상 -->


    <style name="MainTitle">
        <item name="android:text">@string/title</item>
        <item name="android:fontFamily">@font/climatecrisis_regular</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#2E442D</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
        <item name="android:shadowColor">@color/black</item>
    </style>

    <style name="MainTitleReverse">
        <item name="android:text">@string/title</item>
        <item name="android:fontFamily">@font/climatecrisis_regular</item>
        <item name="android:textFontWeight" tools:targetApi="28">400</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- 버튼 텍스트 스타일 -->
    <style name="btnText">
        <item name="android:fontFamily">@font/dmsans_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="block_title">
        <item name="android:fontFamily">@font/dmsans_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:text">@string/block_title</item>
    </style>

    <style name="block_comment">
        <item name="android:fontFamily">@font/dmsans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:text">@string/block_comment</item>
    </style>

    <style name="block_setting">
        <item name="android:fontFamily">@font/dmsans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:text">@string/bolck_setting_comment</item>
    </style>


</resources>